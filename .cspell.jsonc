{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "dictionaries": ["software-terms", "npm", "fullstack"],
  "files": ["**", ".vscode/**", ".github/**"],
  "ignorePaths": ["bun.lock", "plans/reviews/**"],
  "ignoreRegExpList": [
    // TODO(slopradar): dead-config: no checked file contains `apiKey='`, so this pattern ignores nothing; delete it
    "apiKey='[a-zA-Z0-9-]{32}'",
    "'[A-Za-z0-9+/]{24,}={0,2}'",
    "#[0-9a-fA-F]{3,8}(?![0-9a-fA-F])"
  ],
  "import": ["@cspell/dict-bash/cspell-ext.json"],
  "useGitignore": true,
  "version": "0.2",
