{
  "name": "portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "check": "ultracite check",
    "check:links": "bun run ./scripts/check-links.ts",
    "check:spelling": "cspell -c .cspell.jsonc --no-progress --no-summary --no-must-find-files --unique --cache",
    "check:unsafe": "ultracite fix --unsafe true .",
    "check:write": "ultracite fix .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "dev": "next dev",
    "doctor": "react-doctor",
    "email:build": "email build",
    "email:dev": "email dev -p 3001",
    "email:export": "email export",
    "generate-portrait": "bun run ./scripts/generate-portrait.ts && biome format --write \"src/app/(home)/_components/portrait-face.tsx\"",
    "generate-previews": "bun run ./scripts/link-previews/index.ts",
    "postinstall": "fumadocs-mdx",
    "prepare": "lefthook install",
    "preview": "next build && next start",
    "start": "next start",
    "typecheck": "bun run typegen && tsc --noEmit",
    "typegen": "fumadocs-mdx && next typegen"
  },
