{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "!node_modules",
      "!.agents", // vendored agent skills, kept as their authors ship them
      "!.github",
      "!**/public",
      "!**/*.md",
      "!**/*.mdx",
      "!src/components/ui"
    ]
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "a11y": {
        "noSvgWithoutTitle": "off", // inline SVGs are icons or chart marks, hidden or labelled by their parent
        "useSemanticElements": "warn"
      },
      "complexity": {
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": {
            "maxAllowedComplexity": 31 // render-portfolio.ts maps every Simba card type in one function (28)
          }
        }
      },
      "correctness": {
        "useUniqueElementIds": "off" // static ids on one-per-page forms and the portrait SVG defs
      },
      // The rules marked "new in 2.5" below arrived with the Biome 2.5 /
      // ultracite 7.9 preset and flag ~150 existing call sites. They are
      // parked here so the upgrade stays reviewable; adopting any of them is
      // its own change, not a dependency bump.
      "performance": {
        "noAwaitInLoops": "off", // new in 2.5
        "noBarrelFile": "off", // schema, types and utils index files re-export on purpose
        "noJsxPropsBind": "off", // new in 2.5, 66 inline JSX handlers
        "noNamespaceImport": "off" // `* as m` for motion/react-m and `* as schema` for drizzle
      },
      "style": {
        "noIncrementDecrement": "off", // new in 2.5
        "useDestructuring": "off", // new in 2.5
        "useErrorCause": "off" // new in 2.5
      },
      "suspicious": {
        // Graduated out of nursery in Biome 2.5.
        "noLeakedRender": "off", // 49 `cond && <X />` renders, all on booleans or strings
        "noShadow": "off", // new in 2.5
        "noUnnecessaryConditions": "off" // new in 2.5
      },
      "nursery": {
        "useSortedClasses": {
          "fix": "safe",
          "level": "info",
          "options": {
            "functions": ["cn"]
          }
        }
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded",
      "trailingCommas": "es5",
      "jsxQuoteStyle": "single"
    }
  },
  "json": {
    "parser": {
      "allowComments": true
    }
  },
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/react",
    "ultracite/biome/next"
  ]
}
