{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "!node_modules",
      "!.github",
      "!**/public",
      "!**/*.md",
      "!**/*.mdx",
      "!src/components/ui"
    ]
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "a11y": {
        // TODO(slopradar): undocumented-config: unlike the parked 2.5 rules below, `noSvgWithoutTitle`, `useGenericFontNames`, `useUniqueElementIds`, `noBarrelFile`, `noNamespaceImport`, `noNonNullAssertion`, `noLeakedRender` and the cognitive-complexity ceiling of 31 (default 15) are off or loosened with no reason, add a one-line reason beside each or turn it back on
        "noSvgWithoutTitle": "off",
        "useGenericFontNames": "off",
        "useSemanticElements": "warn"
      },
      "complexity": {
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": {
            "maxAllowedComplexity": 31
          }
        }
      },
      "correctness": {
        "useUniqueElementIds": "off"
      },
      // The rules marked "new in 2.5" below arrived with the Biome 2.5 /
      // ultracite 7.9 preset and flag ~150 existing call sites. They are
      // parked here so the upgrade stays reviewable; adopting any of them is
      // its own change, not a dependency bump.
      "performance": {
        "noAwaitInLoops": "off", // new in 2.5
        "noBarrelFile": "off",
        "noJsxPropsBind": "off", // new in 2.5, 66 inline JSX handlers
        "noNamespaceImport": "off"
      },
      "style": {
        "noIncrementDecrement": "off", // new in 2.5
        "noNonNullAssertion": "off",
        "useDestructuring": "off", // new in 2.5
        "useErrorCause": "off" // new in 2.5
      },
      "suspicious": {
        // Graduated out of nursery in Biome 2.5.
        "noLeakedRender": "off",
        "noShadow": "off", // new in 2.5
        "noUnnecessaryConditions": "off" // new in 2.5
      },
      "nursery": {
        "useSortedClasses": {
          "fix": "safe",
          "level": "info",
          "options": {
            "functions": ["cn"]
          }
        }
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded",
      "trailingCommas": "es5",
      "jsxQuoteStyle": "single"
    }
  },
  "json": {
    "parser": {
      "allowComments": true
    }
  },
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/react",
    "ultracite/biome/next"
  ]
}
