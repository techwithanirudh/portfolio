{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "!node_modules",
      "!**/.next",
      "!**/dist",
      "!**/public",
      "!.github",
      "!.vercel",
      "!pnpm-lock.yaml",
      "!bun.lock",
      "!**/*.md",
      "!**/*.mdx",
      "!src/components/ui",
      "!**/*.grit"
    ]
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "a11y": {
        "noSvgWithoutTitle": "off",
        "useGenericFontNames": "off",
        "useSemanticElements": "warn"
      },
      "complexity": {
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": {
            "maxAllowedComplexity": 31
          }
        }
      },
      "correctness": {
        "useUniqueElementIds": "off"
      },
      // The rules marked "new in 2.5" below arrived with the Biome 2.5 /
      // ultracite 7.9 preset and flag ~150 existing call sites. They are
      // parked here so the upgrade stays reviewable; adopting any of them is
      // its own change, not a dependency bump.
      "performance": {
        "noAwaitInLoops": "off", // new in 2.5
        "noBarrelFile": "off",
        "noJsxPropsBind": "off", // new in 2.5, 66 inline JSX handlers
        "noNamespaceImport": "off"
      },
      "style": {
        "noIncrementDecrement": "off", // new in 2.5
        "noNonNullAssertion": "off",
        "useDestructuring": "off", // new in 2.5
        "useErrorCause": "off" // new in 2.5
      },
      "suspicious": {
        // Graduated out of nursery in Biome 2.5.
        "noLeakedRender": "off",
        "noShadow": "off", // new in 2.5
        "noUnnecessaryConditions": "off", // new in 2.5
        // Flags `tw`, which Satori/takumi use to style OG images.
        "noUnknownAttribute": "off"
      },
      "nursery": {
        "useSortedClasses": {
          "fix": "safe",
          "level": "info",
          "options": {
            "functions": ["cn"]
          }
        }
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded",
      "trailingCommas": "es5",
      "jsxQuoteStyle": "single"
    }
  },
  "json": {
    "parser": {
      "allowComments": true
    }
  },
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/react",
    "ultracite/biome/next"
  ]
}
